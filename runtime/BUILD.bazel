# The event-stream framing codec (ADR-0014) and the envelope convention on
# top of it (ADR-0016): a leaf over :core, so consumers pay for it only
# when they stream. The typed EventStream lives in :http (it wraps the
# WebSocket seam there).
cc_library(
    name = "eventstream",
    srcs = [
        "src/eventstream/envelope.cc",
        "src/eventstream/frame.cc",
    ],
    hdrs = [
        "include/smithy/eventstream/envelope.h",
        "include/smithy/eventstream/frame.h",
    ],
    copts = COPTS,
    includes = ["include"],
    deps = [":core"],
)

# The negotiated JSON-text wire encoding (ADR-0018): the envelope a browser
# speaks with JSON.parse alone. Separate from :eventstream so the binary
# codec stays a leaf on :core — only the transports that negotiate the mode
# (and consumers who want the codec directly) pull in :json.
cc_library(
    name = "eventstream_json",
    srcs = ["src/eventstream/json_frame.cc"],
    hdrs = ["include/smithy/eventstream/json_frame.h"],
    copts = COPTS,
    includes = ["include"],
    deps = [
        ":core",
        ":eventstream",
        ":json",
    ],
)

